# Exemplu de .env. De obicei NU il completezi tu: `sudo ./install.sh` te intreaba valorile si scrie `.env` singur.
# `.env` nu se pune in git.

# ---- DE COMPLETAT ----
# Serverul (VPS) catre care se deschide tunelul si de unde se trag programul si fisierele
SSH_TARGET=CHANGE_ME_utilizator@adresa-server
# Cai pe server, asa cum le vede utilizatorul SSH
REMOTE_PROGRAM=CHANGE_ME_program.json
REMOTE_CLIPS_DIR=CHANGE_ME_.
# Adresa si portul pe care asculta tunelul pe server (ex. 127.0.0.1 sau IP-ul docker 172.17.0.1)
VPS_BIND=CHANGE_ME_127.0.0.1
VPS_PORT=18080
# Argumente mpv separate prin spatiu (rezolutia HDMI). Optional: DRM_CONNECTOR=HDMI-A-1
MPV_ARGS=--drm-mode=1280x720
#DRM_CONNECTOR=

# ---- VALORI IMPLICITE (de obicei nu se schimba) ----
# Utilizatorul sub care ruleaza serviciul (se creeaza de install.sh daca lipseste)
SERVICE_USER=mpv-agent
# Portul HTTP local al agentului (doar 127.0.0.1)
AGENT_PORT=8765
# Cheia tunelului se genereaza automat de install.sh daca lipseste; known_hosts il scrie tot install.sh
SSH_KEY=/var/lib/mpv-agent/.ssh/tunnel_ed25519
SSH_KNOWN_HOSTS=/var/lib/mpv-agent/.ssh/known_hosts
# Unde tine agentul programul si fisierele descarcate, si socketul mpv
CACHE_DIR=/var/lib/mpv-agent
MPV_SOCKET=/run/mpv-agent/mpv.sock
